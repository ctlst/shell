[main]
font=monospace:size=9
pad=6x5
term=xterm-256color

[colors]
foreground=@TERM_FOREGROUND_RGB@
background=@TERM_BACKGROUND_RGB@
regular0=@TERM_BLACK_RGB@
regular1=@TERM_RED_RGB@
regular2=@TERM_GREEN_RGB@
regular3=@TERM_YELLOW_RGB@
regular4=@TERM_BLUE_RGB@
regular5=@TERM_MAGENTA_RGB@
regular6=@TERM_CYAN_RGB@
regular7=@TERM_WHITE_RGB@
bright0=@TERM_BRIGHT_BLACK_RGB@
bright1=@TERM_BRIGHT_RED_RGB@
bright2=@TERM_BRIGHT_GREEN_RGB@
bright3=@TERM_BRIGHT_YELLOW_RGB@
bright4=@TERM_BRIGHT_BLUE_RGB@
bright5=@TERM_BRIGHT_MAGENTA_RGB@
bright6=@TERM_BRIGHT_CYAN_RGB@
bright7=@TERM_BRIGHT_WHITE_RGB@

[scrollback]
lines=4000

[mouse]
hide-when-typing=yes
