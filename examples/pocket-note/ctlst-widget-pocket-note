#!/usr/bin/env python3
"""A no-compile, display-only Home note. No network or third-party modules."""
import json
import os
from pathlib import Path
import selectors
import sys
import re

NOTE = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "ctlst/pocket-note.txt"


def read_note():
    try:
        with NOTE.open() as source:
            text = source.read(512)
    except OSError:
        text = "Tiny files. Big little ideas.\nA Python widget — no shell rebuild."
    return (text.splitlines() + ["", ""])[:2]


def read_palette():
    # Compatibility for the current host's order-sensitive token loader.
    # Resolve only public theme values; send validated literal colors in v1.
    palette = dict(SHELL_PANEL="fffaf3ff", SHELL_ACCENT="26766aff",
                   SHELL_TEXT="202421ff", SHELL_MUTED="626b68ff")
    generated = os.environ.get("CTLST_GENERATED_DIR")
    if generated:
        try:
            with (Path(generated) / "theme.env").open() as source:
                for line in source.read(65536).splitlines():
                    key, _, value = line.partition("=")
                    if key in palette and re.fullmatch(r"[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?", value):
                        palette[key] = value
        except OSError:
            pass
    return {key: "#" + value for key, value in palette.items()}


def frame(lines, colors):
    return {"ctlst_widget": 1, "type": "frame",
            "view": {"width": 500, "height": 95, "background": colors["SHELL_PANEL"]},
            "nodes": [
                {"type": "rect", "x": 16, "y": 17, "width": 5, "height": 61,
                 "radius": 2, "fill": colors["SHELL_ACCENT"]},
                {"type": "text", "x": 34, "y": 10, "text": "POCKET NOTE",
                 "size": 11, "weight": "bold", "fill": colors["SHELL_ACCENT"]},
                {"type": "text", "x": 34, "y": 32, "text": lines[0][:52],
                 "size": 17, "weight": "bold", "fill": colors["SHELL_TEXT"]},
                {"type": "text", "x": 34, "y": 62, "text": lines[1][:64],
                 "size": 12, "fill": colors["SHELL_MUTED"]}]}


def main():
    visible, previous = True, None
    # Use raw reads so multiple messages in one pipe read cannot get stranded
    # inside TextIO buffering while selectors waits for another kernel event.
    selector = selectors.DefaultSelector()
    selector.register(sys.stdin, selectors.EVENT_READ)
    pending = b""
    while True:
        force = False
        if selector.select(1 if visible else None):
            data = os.read(sys.stdin.fileno(), 8192)
            if not data:
                return
            pending += data
            if len(pending) > 262144:
                return
            while b"\n" in pending:
                raw, pending = pending.split(b"\n", 1)
                try:
                    message = json.loads(raw)
                except (ValueError, UnicodeDecodeError):
                    continue
                if not isinstance(message, dict) or message.get("ctlst_widget") != 1:
                    continue
                kind = message.get("type")
                if kind == "shutdown":
                    return
                if kind == "visibility":
                    visible = bool(message.get("visible"))
                    force |= visible
                elif kind in ("hello", "configure"):
                    force = True
        if visible or force:
            lines = read_note()
            colors = read_palette()
            if force or (lines, colors) != previous:
                print(json.dumps(frame(lines, colors), separators=(",", ":")), flush=True)
                previous = (lines, colors)


if __name__ == "__main__":
    main()
