#!/usr/bin/env python3
"""Keep Linux/XWayland dialogs and popups inside the phone bar-safe area."""

from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

HOME = Path.home()
SCRIPTS = Path(os.environ.get("CTLST_LIBEXEC_DIR", Path(__file__).resolve().parent))
CLAMP = SCRIPTS / "clamp-floating"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
PID_FILE = RUNTIME / "ctlst-floating-window-guard.pid"

SKIP_APP_PREFIXES = ("dev.ctlst.",)
DIALOG_TYPES = {
    "dialog",
    "utility",
    "popup_menu",
    "splash",
    "notification",
    "toolbar",
}
DIALOG_ROLES = {"pop-up", "popup", "dialog", "alertdialog"}


def swaymsg(*args: str) -> None:
    subprocess.run(
        ["swaymsg", *args],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def should_manage(container: dict) -> bool:
    if (container.get("type") or "") not in {"con", "floating_con"}:
        return False
    app_id = (container.get("app_id") or "").lower()
    if any(app_id.startswith(prefix) for prefix in SKIP_APP_PREFIXES):
        return False
    if app_id in {"wofi", "fuzzel"}:
        return False
    if app_id.startswith("xdg-desktop-portal"):
        return True
    props = container.get("window_properties") or {}
    window_type = (props.get("window_type") or "").lower()
    role = (props.get("window_role") or "").lower()
    floating = container.get("floating") in {"auto_on", "user_on"}
    if floating:
        return True
    if window_type in DIALOG_TYPES:
        return True
    if role in DIALOG_ROLES:
        return True
    transient = props.get("transient_for")
    return transient not in (None, "", "null", 0)


def prepare_and_clamp(container_id: int, floating: bool) -> None:
    cid = str(container_id)
    if not floating:
        swaymsg(
            f"[con_id={cid}] floating enable, "
            'title_format "%title  ⤢", move position center'
        )
        time.sleep(0.05)
    subprocess.run([str(CLAMP), cid], check=False)


class Guard:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.pending: dict[int, threading.Thread] = {}

    def schedule(self, container: dict) -> None:
        container_id = container.get("id")
        if not container_id or not should_manage(container):
            return
        floating = container.get("floating") in {"auto_on", "user_on"}
        with self.lock:
            if container_id in self.pending:
                return
            thread = threading.Thread(
                target=self._worker,
                args=(container_id, floating),
                daemon=True,
            )
            self.pending[container_id] = thread
            thread.start()

    def _worker(self, container_id: int, floating: bool) -> None:
        try:
            for delay in (0.0, 0.08, 0.2, 0.45):
                if delay:
                    time.sleep(delay)
                prepare_and_clamp(container_id, floating)
        finally:
            with self.lock:
                self.pending.pop(container_id, None)

    def handle_event(self, event: dict) -> None:
        change = event.get("change")
        container = event.get("container") or {}
        if change in {"new", "title", "floating"}:
            self.schedule(container)


def acquire_pid_file() -> None:
    RUNTIME.mkdir(parents=True, exist_ok=True)
    if PID_FILE.exists():
        try:
            old = int(PID_FILE.read_text(encoding="ascii").strip())
        except ValueError:
            old = 0
        if old > 1:
            try:
                os.kill(old, 0)
                raise SystemExit(0)
            except OSError:
                pass
    PID_FILE.write_text(f"{os.getpid()}\n", encoding="ascii")


def release_pid_file() -> None:
    try:
        current = int(PID_FILE.read_text(encoding="ascii").strip())
    except (OSError, ValueError):
        return
    if current == os.getpid():
        PID_FILE.unlink(missing_ok=True)


def daemon() -> None:
    acquire_pid_file()
    running = True
    guard = Guard()

    def stop(_signum, _frame) -> None:
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    try:
        while running:
            process = subprocess.Popen(
                ["swaymsg", "-m", "-t", "subscribe", '["window"]'],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
            try:
                for line in process.stdout:
                    if not running:
                        break
                    try:
                        event = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    guard.handle_event(event)
            finally:
                process.terminate()
                try:
                    process.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    process.kill()
            if running:
                time.sleep(0.4)
    finally:
        release_pid_file()


def main() -> None:
    command = sys.argv[1] if len(sys.argv) > 1 else "status"
    if command == "daemon":
        daemon()
    elif command == "status":
        print("running" if PID_FILE.exists() else "stopped")
    else:
        raise SystemExit("usage: floating-window-guard {daemon|status}")


if __name__ == "__main__":
    main()
