#!/usr/bin/env python3
"""Session-owned Waybar with layered native dotfiles and scoped reload."""
import fcntl
import json
import os
import select
import signal
import socket
import subprocess
import sys
from ctlst_config import config_paths, generated_root, runtime_root


def selected_config():
    return next(path for _, path in reversed(config_paths("bar")) if path.is_file())


def waybar_environment():
    """Expose custom user desktop entries to Waybar's legacy search path.

    Waybar 0.15 searches ~/.local/share and XDG_DATA_DIRS, but omits a custom
    XDG_DATA_HOME (upstream src/util/icon_loader.cpp). Scope the compatibility
    path to this child; do not rewrite the session's environment or dotfiles.
    """
    environment = os.environ.copy()
    data_home = environment.get("XDG_DATA_HOME", "")
    if os.path.isabs(data_home):
        directories = environment.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
        environment["XDG_DATA_DIRS"] = data_home + ":" + directories
    return environment


def render_style():
    generated = generated_root()
    generated.mkdir(parents=True, exist_ok=True)
    styles = [generated / "waybar.css"]
    styles += [path for _, path in config_paths("bar-style") if path.is_file()]
    output = generated / "bar.css"
    output.write_text("\n".join(f'@import url("{path.resolve().as_uri()}");' for path in styles) + "\n")
    return output


def run():
    runtime = runtime_root()
    runtime.mkdir(parents=True, exist_ok=True)
    endpoint = runtime / "ctlst-bar.sock"
    mode = sys.argv[1] if len(sys.argv) > 1 else "daemon"
    if mode in ("restart", "reload", "ensure"):
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
            client.sendto(b"?" if mode == "ensure" else b"R", str(endpoint))
        return
    if mode != "daemon":
        raise ValueError("usage: waybar-daemon {daemon|reload|restart|ensure}")
    with (runtime / "ctlst-bar.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        endpoint.unlink(missing_ok=True)
        child = None
        running = True
        def stop(_sig, _frame):
            nonlocal running
            running = False
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, stop)
        def stop_child():
            if child is not None and child.poll() is None:
                child.terminate()
                try:
                    child.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait()
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as server:
            server.bind(str(endpoint))
            failures = 0
            try:
                while running:
                    if child is None or child.poll() is not None:
                        config, style = selected_config(), render_style()
                        child = subprocess.Popen(["waybar", "--config", str(config), "--style", str(style)],
                                                 env=waybar_environment())
                        (runtime / "ctlst-bar.json").write_text(json.dumps({"pid": child.pid, "config": str(config), "style": str(style)}))
                        failures += 1
                        if failures > 5:
                            raise RuntimeError("Waybar repeatedly exited; inspect the session log")
                    if select.select([server], [], [], 0.5)[0] and server.recv(64) == b"R":
                        stop_child()
                        child = None
                        failures = 0
            finally:
                stop_child()
                endpoint.unlink(missing_ok=True)
                (runtime / "ctlst-bar.json").unlink(missing_ok=True)


if __name__ == "__main__":
    run()
