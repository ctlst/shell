#!/usr/bin/env python3
"""Control the resident drawer through its session-local endpoint."""
import os
import socket
import subprocess
import sys
import time
from ctlst_config import libexec_root, runtime_root

mode = sys.argv[1] if len(sys.argv) > 1 else "toggle"
if mode not in ("toggle", "show", "close"):
    raise SystemExit(2)
runtime = runtime_root()
visible = (runtime / "ctlstdrawer.visible").exists()
command = b"H" if mode == "close" or (mode == "toggle" and visible) else b"S"
path = runtime / "ctlst-drawer.sock"
started = time.monotonic()
spawned = False
while True:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
            client.sendto(command, str(path))
        break
    except (FileNotFoundError, ConnectionRefusedError):
        if command == b"H":
            raise SystemExit(0)
        elapsed = time.monotonic() - started
        if elapsed > 15:
            raise SystemExit("ctlstdrawer: resident drawer did not become ready")
        # A stale endpoint can remain between logins. Give the session's own
        # startup a chance before starting the GTK single-instance fallback.
        if elapsed > 2 and not spawned:
            env = os.environ | {"CTLST_DRAWER_RESIDENT": "1",
                                "LD_PRELOAD": "/usr/lib/libgtk4-layer-shell.so.0"}
            subprocess.Popen([str(libexec_root() / "ctlstdrawer-ui")], env=env,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
            spawned = True
        time.sleep(0.05)
