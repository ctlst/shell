#!/usr/bin/env python3
"""Touch-first GTK4 settings for the Sway Touch shell."""

import json
import os
import subprocess
import sys
import threading
import time
from pathlib import Path

# Match the accelerated shell path; retain explicit diagnostic/VM overrides.
os.environ.setdefault("GSK_RENDERER", "gl")

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango


SCRIPT_DIR = Path(__file__).resolve().parent
WALLPAPER = SCRIPT_DIR / "ctlst-wallpaper"
MEMORY = SCRIPT_DIR / "ctlst-memory-status"
RESTART_SWAY = SCRIPT_DIR / "restart-sway"
SHADE = SCRIPT_DIR / "ctlstshade"
THEME = SCRIPT_DIR / "ctlst-theme"
SCREEN_IDLE = SCRIPT_DIR / "screen-idle"
SOUND = SCRIPT_DIR / "sound-profile"
AUTO_ROTATE = SCRIPT_DIR / "auto-rotate"


def call_json(command):
    try:
        result = subprocess.run(command, check=False, text=True, capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RuntimeError(str(error)) from error
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Command failed")
    return json.loads(result.stdout)


def output_lines(command):
    if "/" in str(command[0]) and not Path(command[0]).is_file():
        return []
    try:
        result = subprocess.run(command, check=False, text=True, capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RuntimeError(str(error)) from error
    return [line for line in result.stdout.splitlines() if line] if not result.returncode else []


class Settings(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.ctlst.Settings")
        self.status_text = ""
        self.status_label = None
        self.wallpapers = []
        self.wallpaper_ids = []
        self.build_generation = 0
        self.activation_started = 0.0
        self.jobs = {}
        self.display_refresh_pending = False
        self.display_notice = ""
        self.theme_refresh_pending = False
        self.theme_notice = ""
        self.theme_draft = None
        self.wallpaper_draft = None
        self.wallpaper_mode = None
        self.wallpaper_notice = ""
        self.wallpaper_refresh_pending = False
        self.wallpaper_preview_serial = 0
        self.wallpaper_preview_pending = False
        self.wallpaper_file_open = False
        self.memory_refresh_pending = False
        self.memory_notice = ""
        self.debug = os.environ.get("CTLST_SETTINGS_DEBUG", "").lower() in {
            "1",
            "true",
            "yes",
        }

    def trace(self, label):
        diagnostic = os.environ.get("CTLST_SETTINGS_DEBUG_LOG")
        if diagnostic:
            with open(diagnostic, "a", encoding="utf-8") as stream:
                stream.write(label + "\n")
        if self.debug:
            elapsed = (time.monotonic() - self.activation_started) * 1000
            print(f"ctlst-settings: {label} at {elapsed:.0f}ms", file=sys.stderr)

    def background(self, key, work, finished):
        """Helpers and owned image decoding run off-thread; GTK stays on its loop."""
        if key in self.jobs:
            return False
        token = object()
        self.jobs[key] = token
        window, generation = self.props.active_window, self.build_generation
        self.hold()

        def complete(value, error):
            try:
                if self.jobs.get(key) is token:
                    del self.jobs[key]
                if self.props.active_window is window and generation == self.build_generation:
                    finished(value, error)
                if key == "display" and self.display_refresh_pending and self.props.active_window:
                    self.display_refresh_pending = False
                    self.refresh_display()
                if key == "appearance" and self.theme_refresh_pending and self.props.active_window:
                    self.theme_refresh_pending = False
                    self.refresh_themes()
                if key == "wallpaper" and self.wallpaper_refresh_pending and self.props.active_window:
                    self.wallpaper_refresh_pending = False
                    self.refresh_wallpapers()
                if key == "wallpaper-preview" and self.wallpaper_preview_pending and self.props.active_window:
                    self.wallpaper_preview_pending = False
                    self.update_wallpaper_preview()
                if key == "memory" and self.memory_refresh_pending and self.props.active_window:
                    self.memory_refresh_pending = False
                    self.refresh_memory()
            finally:
                self.release()
            return GLib.SOURCE_REMOVE

        def run():
            try:
                value, error = work(), None
            except Exception as failure:
                value, error = None, str(failure)
            GLib.idle_add(complete, value, error)

        try:
            threading.Thread(target=run, name="ctlst-settings-" + key, daemon=True).start()
        except RuntimeError as error:
            complete(None, str(error))
        return True

