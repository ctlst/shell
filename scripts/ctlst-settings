            self.theme_provider.load_from_path(str(self.theme_path))
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), self.theme_provider, Gtk.STYLE_PROVIDER_PRIORITY_USER
            )
            self.theme_monitor = Gio.File.new_for_path(str(self.theme_path.parent)).monitor_directory(Gio.FileMonitorFlags.NONE, None)
