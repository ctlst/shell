#!/usr/bin/env python3
"""List and select package themes through the user's ordinary theme.conf."""
import os
import re
import subprocess
import sys
from ctlst_config import data_root, resolved, user_path

mode = sys.argv[1] if len(sys.argv) > 1 else "current"
themes = sorted(p.name for p in (data_root() / "themes").iterdir() if (p / "theme.env").is_file())
current = resolved("theme")[0].get("theme", "name")
if mode == "list":
    print("\n".join(themes))
elif mode == "current":
    print(current)
elif mode in ("apply", "cycle"):
    name = themes[(themes.index(current) + 1) % len(themes)] if mode == "cycle" else sys.argv[2]
    if name not in themes:
        raise SystemExit("Unknown theme")
    path = user_path("theme")
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text() if path.is_file() else "[theme]\n"
    # Edit only the selected name, preserving comments and other user values.
    if re.search(r"(?m)^name\s*=", text):
        text = re.sub(r"(?m)^name\s*=.*$", f"name = {name}", text)
    else:
        text = text.replace("[theme]", f"[theme]\nname = {name}", 1)
    path.write_text(text)
    raise SystemExit(subprocess.call(["ctlst-session", "reload"]))
else:
    raise SystemExit("usage: ctlst-theme {list|current|apply NAME|cycle}")
