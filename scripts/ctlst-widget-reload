#!/usr/bin/env python3
"""Restart only this CTLST session's Home, keeping apps and Sway alive."""
import os
from pathlib import Path
import signal
import subprocess
import time

from ctlst_config import component_environment


def main():
    token = os.environ.get("CTLST_SESSION_ID")
    sock = os.environ.get("SWAYSOCK")
    if not token or not sock or not Path(sock).is_socket():
        raise SystemExit("Run ctlst-widget reload from a terminal inside the CTLST session.")
    matches = []
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid != os.getuid() or (proc / "comm").read_text().strip() != "ctlsthome":
                continue
            env = (proc / "environ").read_bytes().split(b"\0")
            if f"CTLST_SESSION_ID={token}".encode() in env and f"SWAYSOCK={sock}".encode() in env:
                matches.append(int(proc.name))
        except (OSError, ValueError):
            continue
    if len(matches) != 1:
        raise SystemExit(f"Expected one Home in this session; found {len(matches)}. Nothing changed.")
    environment = component_environment()  # Validate before stopping the old Home.
    pid = matches[0]
    os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + 5
    while Path(f"/proc/{pid}").exists():
        if time.monotonic() >= deadline:
            raise SystemExit("Home did not exit; refusing to start a duplicate.")
        time.sleep(.05)
    subprocess.Popen(["ctlsthome"], env=environment, start_new_session=True,
                     stdin=subprocess.DEVNULL)
    print("Restarted Home; applications and Sway were not restarted.")


if __name__ == "__main__":
    main()
