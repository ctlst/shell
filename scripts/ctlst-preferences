#!/usr/bin/env python3
"""Versioned, local preference authority for Sway Touch clients."""

import argparse
import json
import os
import re
import sys
import tempfile
from pathlib import Path


VERSION = 1
MAX_FAVORITES = 35
RESERVED_FAVORITE = "ctlst:apps"
DEFAULT_FAVORITES = (
    RESERVED_FAVORITE,
    "foot.desktop",
    "dev.ctlst.Settings.desktop",
)
WALLPAPER_MODES = ("fill", "fit", "center")
DESKTOP_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*\.desktop\Z")
RELATIVE_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_. /-]*\Z")


class PreferenceError(Exception):
    pass


def config_home():
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")


def data_home():
    return Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")


def state_path():
    return config_home() / "ctlst" / "preferences.json"


def default_state():
    return {
        "version": VERSION,
        "favorites": list(DEFAULT_FAVORITES),
        "drawer_hidden": [],
        "wallpaper": {
            "id": "packaged:ctlst-dusk-mountains-1080x2160.png",
            "mode": "fill",
        },
    }


def desktop_directories():
    directories = [data_home() / "applications"]
    directories.extend(
        Path(directory) / "applications"
        for directory in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
        if directory
    )
    return directories


def desktop_id_syntax(value):
    return isinstance(value, str) and bool(DESKTOP_ID.fullmatch(value))


def installed_desktop_id(value):
    return (
        desktop_id_syntax(value)
        and any((directory / value).is_file() for directory in desktop_directories())
    )


def wallpaper_root(kind):
    if kind == "system":
        return Path(os.environ.get("CTLST_SYSTEM_WALLPAPER_DIR", "/usr/share/wallpapers"))
    if kind == "managed":
        return data_home() / "ctlst/wallpapers"
    if kind == "packaged":
        return Path(os.environ.get("CTLST_DATA_DIR", "/usr/share/ctlst-shell")) / "wallpapers"
    raise PreferenceError("wallpaper ID must start with system:, managed: or packaged:")


def valid_wallpaper_id(value):
    if not wallpaper_id_syntax(value):
        return False
    kind, relative = value.split(":", 1)
    root = wallpaper_root(kind)
    try:
        candidate = (root / relative).resolve(strict=True)
        root = root.resolve(strict=True)
    except OSError:
        return False
    return candidate.is_file() and candidate.is_relative_to(root)


def wallpaper_id_syntax(value):
    if not isinstance(value, str) or ":" not in value:
        return False
    kind, relative = value.split(":", 1)
    if (
        kind not in ("system", "managed", "packaged")
        or not RELATIVE_ID.fullmatch(relative)
        or any(component in (".", "..") for component in Path(relative).parts)
    ):
        return False
    return True


def normalize_state(state):
    if not isinstance(state, dict):
        raise PreferenceError("preferences must be a JSON object")
    allowed = {"version", "favorites", "wallpaper", "drawer_hidden"}
    extra = set(state) - allowed
    if extra:
        raise PreferenceError(
            "preferences must contain only version, favorites, drawer_hidden, and wallpaper"
        )
    if "drawer_hidden" not in state:
        state["drawer_hidden"] = []
    return state


def validate(state):
    normalize_state(state)
    if state["version"] != VERSION:
        raise PreferenceError("unsupported preferences version")
    favorites = state["favorites"]
    if not isinstance(favorites, list) or len(favorites) > MAX_FAVORITES:
        raise PreferenceError("favorites must be a list with at most %d entries" % MAX_FAVORITES)
    if len(set(favorites)) != len(favorites):
        raise PreferenceError("favorites must be unique")
    for favorite in favorites:
        if favorite != RESERVED_FAVORITE and not desktop_id_syntax(favorite):
            raise PreferenceError("favorite must be ctlst:apps or a desktop ID")
    drawer_hidden = state["drawer_hidden"]
    if not isinstance(drawer_hidden, list):
        raise PreferenceError("drawer_hidden must be a list")
    if len(set(drawer_hidden)) != len(drawer_hidden):
        raise PreferenceError("drawer_hidden must be unique")
    for desktop_id in drawer_hidden:
        if not desktop_id_syntax(desktop_id):
            raise PreferenceError("drawer_hidden entries must be desktop IDs")
    wallpaper = state["wallpaper"]
    if wallpaper is not None:
        if not isinstance(wallpaper, dict) or set(wallpaper) != {"id", "mode"}:
            raise PreferenceError("wallpaper must be null or contain only id and mode")
        if not wallpaper_id_syntax(wallpaper["id"]):
            raise PreferenceError("wallpaper ID is invalid")
        if wallpaper["mode"] not in WALLPAPER_MODES:
            raise PreferenceError("wallpaper mode must be fill, fit, or center")


def load_state():
    path = state_path()
    if not path.exists():
        return default_state()
    try:
        with path.open(encoding="utf-8") as handle:
            state = json.load(handle)
    except (OSError, json.JSONDecodeError) as error:
        raise PreferenceError("could not read preferences: %s" % error) from error
    validate(state)
    return state


def save_state(state):
    validate(state)
    path = state_path()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    encoded = (json.dumps(state, sort_keys=True, separators=(",", ":")) + "\n").encode()
    descriptor, temporary_name = tempfile.mkstemp(prefix=".preferences.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            os.fchmod(handle.fileno(), 0o600)
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_name, path)
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def emit(value):
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))


def main(argv):
    parser = argparse.ArgumentParser(prog="ctlst-preferences")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("get")
    favorites = commands.add_parser("favorites").add_subparsers(
        dest="favorites_command", required=True
    )
    favorites.add_parser("list")
    add = favorites.add_parser("add")
    add.add_argument("desktop_id")
    remove = favorites.add_parser("remove")
    remove.add_argument("desktop_id")
    favorites.add_parser("reset")
    drawer_hidden = commands.add_parser("drawer-hidden").add_subparsers(
        dest="drawer_hidden_command", required=True
    )
    drawer_hidden.add_parser("list")
    hide = drawer_hidden.add_parser("add")
    hide.add_argument("desktop_id")
    unhide = drawer_hidden.add_parser("remove")
    unhide.add_argument("desktop_id")
    wallpaper = commands.add_parser("wallpaper").add_subparsers(
        dest="wallpaper_command", required=True
    )
    wallpaper.add_parser("get")
    set_wallpaper = wallpaper.add_parser("set")
    set_wallpaper.add_argument("wallpaper_id")
    set_wallpaper.add_argument("mode", choices=WALLPAPER_MODES)
    arguments = parser.parse_args(argv)

    state = load_state()
    if arguments.command == "get":
        emit(state)
    elif arguments.command == "favorites":
        if arguments.favorites_command == "list":
            emit(state["favorites"])
        elif arguments.favorites_command == "reset":
            state["favorites"] = default_state()["favorites"]
            save_state(state)
            emit(state["favorites"])
        elif arguments.favorites_command == "add":
            desktop_id = arguments.desktop_id
            if desktop_id != RESERVED_FAVORITE and not installed_desktop_id(desktop_id):
                raise PreferenceError("favorite must be an installed desktop ID")
            if desktop_id in state["favorites"]:
                raise PreferenceError("favorite already exists")
            if len(state["favorites"]) >= MAX_FAVORITES:
                raise PreferenceError("favorites already contains %d entries" % MAX_FAVORITES)
            state["favorites"].append(desktop_id)
            save_state(state)
            emit(state["favorites"])
        else:
            desktop_id = arguments.desktop_id
            if desktop_id not in state["favorites"]:
                raise PreferenceError("favorite does not exist")
            state["favorites"].remove(desktop_id)
            save_state(state)
            emit(state["favorites"])
    elif arguments.command == "drawer-hidden":
        if arguments.drawer_hidden_command == "list":
            emit(state["drawer_hidden"])
        else:
            desktop_id = arguments.desktop_id
            if not desktop_id_syntax(desktop_id):
                raise PreferenceError("drawer_hidden entry must be a desktop ID")
            if arguments.drawer_hidden_command == "add":
                if desktop_id in state["drawer_hidden"]:
                    raise PreferenceError("drawer_hidden entry already exists")
                state["drawer_hidden"].append(desktop_id)
            else:
                if desktop_id not in state["drawer_hidden"]:
                    raise PreferenceError("drawer_hidden entry does not exist")
                state["drawer_hidden"].remove(desktop_id)
            save_state(state)
            emit(state["drawer_hidden"])
    elif arguments.wallpaper_command == "get":
        emit(state["wallpaper"])
    else:
        if not valid_wallpaper_id(arguments.wallpaper_id):
            raise PreferenceError("wallpaper ID does not name an available wallpaper")
        state["wallpaper"] = {"id": arguments.wallpaper_id, "mode": arguments.mode}
        save_state(state)
        emit(state["wallpaper"])


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except PreferenceError as error:
        print("ctlst-preferences: %s" % error, file=sys.stderr)
        raise SystemExit(2)
