#!/usr/bin/env python3
"""Battery dashboard, recorder and machine-readable history."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from ctlst_battery import daemon, export_csv, report, settings, telemetry


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", nargs="?", default="show",
                        choices=("show", "daemon", "sample", "status", "report", "export", "config-check"))
    parser.add_argument("--hours", type=float, default=24,
                        help="history window, 0 = since last observed full (24h if unknown)")
    parser.add_argument("--format", choices=("json", "csv"), default="json")
    args = parser.parse_args()
    if not 0 <= args.hours <= 2160:
        parser.error("--hours must be between 0 and 2160")
    if args.command == "show":
        from ctlst_battery_ui import run
        return run()
    if args.command in ("daemon", "sample"):
        daemon(once=args.command == "sample")
    elif args.command == "config-check":
        print(json.dumps(settings(), indent=2))
    elif args.command == "status":
        print(json.dumps(telemetry(settings()["device"]), indent=2))
    else:
        data = report(args.hours)
        print(export_csv(data) if args.format == "csv" else json.dumps(data, indent=2), end="\n")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError) as error:
        raise SystemExit(f"ctlst-battery: {error}")
