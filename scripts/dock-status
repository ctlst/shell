#!/usr/bin/env python3

import json
import os
import sqlite3
import sys
import time
from pathlib import Path


HOME = Path.home()
MESSAGE_DB = HOME / ".local/share/spacebar/messages.sqlite"
CALL_DB = HOME / ".local/share/plasma-dialer/calls.sqlite"
STATE_DIR = HOME / ".local/state/sway-touch"
MISSED_SEEN = STATE_DIR / "missed-call-seen"
LAST_TOUCH = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / (
    "ctlst-last-touch"
)


def query_value(path, sql, parameters=()):
    try:
        with sqlite3.connect(path) as database:
            row = database.execute(sql, parameters).fetchone()
        return 0 if row is None or row[0] is None else int(row[0])
    except (OSError, sqlite3.Error, ValueError):
        return 0


def output(label, count, singular):
    text = label if count == 0 else f"{label} {count}"
    tooltip = f"No {singular}s" if count == 0 else (
        f"1 {singular}" if count == 1 else f"{count} {singular}s"
    )
    print(json.dumps({
        "text": text,
        "tooltip": tooltip,
        "class": "unread" if count else "idle",
    }))


def unread_messages():
    return query_value(
        MESSAGE_DB,
        "SELECT COUNT(*) FROM Messages WHERE read = 0",
    )


def newest_missed_call():
    return query_value(
        CALL_DB,
        "SELECT COALESCE(MAX(id), 0) FROM History "
        "WHERE direction != 2 AND duration = 0",
    )


def missed_calls():
    newest = newest_missed_call()
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if not MISSED_SEEN.exists():
        MISSED_SEEN.write_text(f"{newest}\n", encoding="ascii")
        return 0
    try:
        seen = int(MISSED_SEEN.read_text(encoding="ascii").strip() or "0")
    except (OSError, ValueError):
        seen = newest
    return query_value(
        CALL_DB,
        "SELECT COUNT(*) FROM History "
        "WHERE direction != 2 AND duration = 0 AND id > ?",
        (seen,),
    )


def touch_was_swipe():
    time.sleep(0.04)
    try:
        timestamp, moved = LAST_TOUCH.read_text(encoding="ascii").split()
        age = time.monotonic_ns() // 1000 - int(timestamp)
        return moved == "1" and 0 <= age <= 2_000_000
    except (OSError, ValueError):
        return False


def open_phone():
    if touch_was_swipe():
        return
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    MISSED_SEEN.write_text(f"{newest_missed_call()}\n", encoding="ascii")
    app_run = HOME / ".local/share/sway-touch/scripts/app-run"
    os.execv(
        app_run,
        [str(app_run), "desktop", "dev.ctlst.Dialer.desktop"],
    )


def open_messages():
    if touch_was_swipe():
        return
    app_run = HOME / ".local/share/sway-touch/scripts/app-run"
    os.execv(
        app_run,
        [str(app_run), "desktop", "dev.ctlst.Messages.desktop"],
    )


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "messages":
        output("TEXT", unread_messages(), "unread message")
    elif command == "phone":
        output("CALL", missed_calls(), "missed call")
    elif command == "phone-open":
        open_phone()
    elif command == "messages-open":
        open_messages()
    else:
        raise SystemExit(
            "usage: dock-status {messages|messages-open|phone|phone-open}"
        )


if __name__ == "__main__":
    main()
