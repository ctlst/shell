#!/usr/bin/env python3
"""Render every CTLST surface from one validated semantic theme file."""

from __future__ import annotations

import argparse
import json
import os
import re
import tempfile
from collections import OrderedDict
from pathlib import Path


KEY_RE = re.compile(r"[A-Z][A-Z0-9_]*\Z")
COLOR_RE = re.compile(r"(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})\Z")
PLACEHOLDER_RE = re.compile(r"@([A-Z][A-Z0-9_]*(?:_(?:CSS|HEX|RGB|ALPHA))?)@")

COLOR_KEYS = (
    "SHELL_BG",
    "SHELL_RAISED",
    "SHELL_PANEL",
    "SHELL_PANEL_ALT",
    "SHELL_LINE",
    "SHELL_LINE_SOFT",
    "SHELL_TEXT",
    "SHELL_MUTED",
    "SHELL_ACCENT",
    "SHELL_ACCENT_SOFT",
    "SHELL_WARM",
    "SHELL_DANGER",
    "SHELL_DANGER_ACTIVE",
    "SHELL_SELECTED_TEXT",
    "SHELL_ON_WALLPAPER",
    "SHELL_OVERLAY",
    "KEYBOARD_BG",
    "KEYBOARD_FG",
    "KEYBOARD_FG_SPECIAL",
    "KEYBOARD_PRESS",
    "KEYBOARD_PRESS_SPECIAL",
    "KEYBOARD_TEXT",
    "KEYBOARD_TEXT_SPECIAL",
    "PAD_SURFACE",
    "PAD_CONTROL",
    "PAD_ACCENT",
    "PAD_TEXT",
    "PAD_FACE_A",
    "PAD_FACE_B",
    "PAD_FACE_X",
    "PAD_FACE_Y",
    "ACTION_HUB",
    "ACTION_HUB_TEXT",
    "ACTION_PAD",
    "ACTION_PAD_TEXT",
    "ACTION_KEYS",
    "ACTION_KEYS_TEXT",
    "ACTION_CLOSE",
    "ACTION_CLOSE_TEXT",
    "ACTION_RING",
    "LOCK_BG_TOP",
    "LOCK_BG_BOTTOM",
)

DEFAULTS = OrderedDict(
    (
        ("THEME_MODE", "dark"),
        ("ICON_THEME", "Papirus"),
        ("WALLPAPER", ""),
        ("FOLLOW_THEME_WALLPAPER", "1"),
        ("SHELL_BG", "111917ff"),
        ("SHELL_RAISED", "1b2724ff"),
