        ("ACTION_CLOSE", "b64a37ff"),
        ("ACTION_CLOSE_TEXT", "fff8edff"),
        ("ACTION_RING", "f4ede3ff"),
        ("LOCK_BG_TOP", "07131cff"),
        ("LOCK_BG_BOTTOM", "0b2425ff"),
        ("CTLST_TOUCH_MIN", "48"),
        ("CTLST_PRIMARY_MIN", "56"),
        ("CTLST_RADIUS_CONTROL", "16"),
        ("CTLST_RADIUS_CARD", "24"),
        ("CTLST_RADIUS_SHEET", "30"),
        ("CTLST_SPACING", "8"),
        ("CTLST_FOCUS_WIDTH", "0"),
