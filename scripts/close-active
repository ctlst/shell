#!/bin/sh
set -eu

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -e "$runtime_dir/ctlstdrawer.visible" ] &&
    "${CTLST_LIBEXEC_DIR:-/usr/libexec/ctlst-shell}/ctlstdrawer" close; then
    exit 0
fi

# Layer-shell launchers are not part of Sway's normal window tree.
if pgrep -x fuzzel >/dev/null 2>&1; then
    pkill -x fuzzel
    exit 0
fi

exec python3 "${CTLST_LIBEXEC_DIR:-/usr/libexec/ctlst-shell}/ctlst_close.py" "$@"
